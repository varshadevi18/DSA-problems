
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int [] nums= new int[n];
        for(int i=0;i<n;i++){
            nums[i]= sc.nextInt();
        }
        int p=1;
        for(int j=0;j<n;j++){
            if(nums[j]==0){
                p=0;
            }
            else{
                p*= nums[j];
            }
        }
        for(int i=0; i<n;i++){
            nums[i]= p/nums[i];
        }
        for(int i=0;i<n;i++){
            System.out.print(nums[i]);
        }
    }
}
