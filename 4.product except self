1. brute
class Solution {
    public int[] productExceptSelf(int[] nums) {
        int n = nums.length;
        int[] ans = new int[n];

        for(int i = 0; i < n; i++) {
            int product = 1;

            for(int j = 0; j < n; j++) {
                if(i != j) {
                    product *= nums[j];
                }
            }

            ans[i] = product;
        }

        return ans;
    }
}
2. optimal prefix suffix
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int [] nums= new int[n];
        int[] ans= new int[n];
        for(int i=0;i<n;i++){
            nums[i]= sc.nextInt();
        }
        ans[0]=1;
        for(int i=1; i<n;i++){
            ans[i]= ans[i-1]*nums[i-1];
        }
        int suffix=1;
        for(int j=n-1;j>=0;j--){
            ans[j]*=suffix;
            suffix*=nums[j];
        }
        for(int i=0;i<n;i++){
            System.out.print(ans[i]);
        }
    }
}
