    long[] arr= new long[n];
    for(List<Integer> q: queries ){
        int a= q.get(0);
        int b= q.get(1);
        int k= q.get(2);
        for(int i=a-1;i<=b-1;i++){
            arr[i]+=k;
        }
    }
    long max=0;
    for(int j=0;j<n;j++){
        max= Math.max(max, arr[j]);
    }
    return max;
    
