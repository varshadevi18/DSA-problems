public static long arrayManipulation(int n, List<List<Integer>> queries) {

    long[] arr = new long[n + 2];

    for(List<Integer> q : queries) {
        int a = q.get(0);
        int b = q.get(1);
        int k = q.get(2);

        arr[a] += k;
        arr[b + 1] -= k;
    }

    long current = 0;
    long max = 0;

    for(int j = 1; j <= n; j++) {
        current += arr[j];
        max = Math.max(max, current);
    }

    return max;
}
