class Solution {
    public static void reversal(int []nums, int start, int end){
        int left=start;
        int right=end-1;
        while(left<right){
            int temp= nums[left];
            nums[left]=nums[right];
            nums[right]= temp;
            left++;
            right--;
        }
    }
    public void rotate(int[] nums, int k) {
        int n= nums.length;
        int d=k;
        if(k>n){
            d= k%n;
        }
        reversal(nums, n-d,n);
        reversal(nums, 0,n-d);
        reversal(nums,0,n);

    }
}
