class Solution {
    int missingNum(int arr[]) {
        // code here
        
        int n= arr.length;
        int m= n+1;
        int os=0;
        int as=0;
        int num=0;
        for(int i=1;i<=m;i++){
            os+=i;
        }
        for(int i=0;i<n;i++){
            as+=arr[i];
        }
        num= os-as;
        return num;
    }
}
