class Solution {
    public void reverse(int arr[], int start){
        int left=start;
        int right=start+1;
        if(left<right){
            int temp= arr[left];
            arr[left]= arr[right];
            arr[right]= temp;
        }
    }
    public void sortInWave(int arr[]) {
        // code here
        int n= arr.length;
        for(int i=0;i<n-1;i+=2){
            reverse(arr,i);
        }
        
    }
}
