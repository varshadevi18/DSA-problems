import java.util.*;
import java.lang.*;
import java.io.*;

class Main
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc= new Scanner(System.in);
		int n= sc.nextInt();
		int [] arr= new int[n];
		for(int i=0; i<n;i++){
		    arr[i]= sc.nextInt();
		}
		// multiply odd index by 2
		// add 10 to even index
		for(int i=0;i<n;i++){
		    if(i%2==0){
		        arr[i]+=10;
		    }
		    else{
		        arr[i]*=2;
		    }
		}
		for(int i=0; i<n;i++){
		    System.out.println(arr[i]);
		}
	}
}
