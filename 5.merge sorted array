class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {
        int k= m+n;
        int[] ans= new int[k];
        int i=0,j=0;
        int c=0;
        while(i<m && j<n){
            if(nums1[i]>nums2[j]){
                ans[c]=nums2[j];
                j++;
            }else{
            ans[c]=nums1[i];
            i++;
            }
            c++;
        }
        while(i<m){
            ans[c]= nums1[i];
            c++;
            i++;
        }
        while(j<n){
            ans[c]= nums2[j];
            j++;
            c++;
        }
        for(int g=0; g<k;g++){
            nums1[g]=ans[g];
        }
        return;
    }
}
