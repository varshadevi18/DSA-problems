1. swapping
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int [] nums= new int[n];
        for(int i=0;i<n;i++){
            nums[i]= sc.nextInt();
        }
        for(int i=0; i<n;i++){
            for(int j=i+1;j<n;j++){
                if(nums[i]==0){
                    int temp= nums[i];
                    nums[i]= nums[j];
                    nums[j]= temp;
                }
            }
        }
        for(int i=0;i<n;i++){
            System.out.print(nums[i]);
        }
    }
}
2. new array (one for loop) space complexity
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int [] nums= new int[n];
        int [] arr= new int[n];
        for(int i=0;i<n;i++){
            nums[i]= sc.nextInt();
        }
        int k=0;
        for(int j=0;j<n;j++){
            if(nums[j]!=0){
                arr[k]= nums[j];
                k++;
            }
        }
        for(int i=0;i<n;i++){
            System.out.print(arr[i]);
        }
    }
}
3. two pointer optimal
class Solution {
    public void moveZeroes(int[] nums) {
        int n= nums.length;
        int i=0;
        int j=0;  
        while(j<n){
            if(nums[j]!=0){
                int temp= nums[i];
                nums[i]=nums[j];
                nums[j]= temp;
                i++;
                j++;
            }
            else{
                j++;
            }
        }
    }
}
