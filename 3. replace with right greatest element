1. O(n2)
import java.util.*;
class Main{
    public static void main(String[] args){
        Scanner sc= new Scanner(System.in);
        int n= sc.nextInt();
        int [] arr= new int[n];
        for(int i=0;i<n;i++){
            arr[i]= sc.nextInt();
        }
        for(int i=0;i<n-1;i++){
            int a= arr[i+1];
            for(int j=i+2; j<n;j++){
                if(arr[j]> a){
                    a = arr[j];
                }
                arr[i]= a;
            }
        }
        arr[n-1]= -1;
        
        for(int i=0;i<n;i++){
            System.out.print(arr[i]);
        }
    }
}
